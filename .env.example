# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. In Docker/Coolify, `db` is the compose service
# name (or the internal hostname Coolify shows for a Postgres resource).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ─── Optional (safe defaults shown) ──────────────────────────────────────────
# Set to "true" when the provider requires TLS (Neon, Supabase, RDS, …).
DATABASE_SSL="false"
# Only relevant with DATABASE_SSL=true: verify the server certificate.
DATABASE_SSL_STRICT="false"

# Connection pool + per-statement timeout.
DATABASE_POOL_MAX="10"
DATABASE_STATEMENT_TIMEOUT_MS="10000"

# Run `drizzle/*.sql` migrations on container start (Docker entrypoint only).
RUN_MIGRATIONS="true"

# Next.js telemetry.
NEXT_TELEMETRY_DISABLED="1"

# ─── docker-compose only ─────────────────────────────────────────────────────
# Host port for the web service (ignored by Coolify, which routes via Traefik).
APP_PORT="3000"
POSTGRES_USER="ytcpm"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ytcpm"
