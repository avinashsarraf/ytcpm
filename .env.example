# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. In Docker/Coolify, `db` is the compose service
# name (or the internal hostname Coolify shows for a Postgres resource).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ─── Optional (safe defaults shown) ──────────────────────────────────────────
# Set to "true" when the provider requires TLS (Neon, Supabase, RDS, …).
DATABASE_SSL="false"
# Only relevant with DATABASE_SSL=true: verify the server certificate.
DATABASE_SSL_STRICT="false"

# Connection pool + per-statement timeout.
DATABASE_POOL_MAX="10"
DATABASE_STATEMENT_TIMEOUT_MS="10000"

# Run `drizzle/*.sql` migrations on container start (Docker entrypoint only).
RUN_MIGRATIONS="true"

# Next.js telemetry.
NEXT_TELEMETRY_DISABLED="1"

# ─── docker-compose only ─────────────────────────────────────────────────────
# Host port for the web service (ignored by Coolify, which routes via Traefik).
APP_PORT="3000"
POSTGRES_USER="ytcpm"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ytcpm"

# ─── Channel Auditor (public YouTube channel audits) ─────────────────────────
# YouTube Data API key. Required for live audits; the key stays server-side.
YOUTUBE_API_KEY=""

# Signs audit pagination/export tokens. Use 32+ random characters.
# Generate with: openssl rand -hex 32
AUDIT_SIGNING_SECRET=""

# "free" (default) keeps every audit free and shows no pricing anywhere.
# Set to "paid" only when optional paid features are ready to be published;
# the public page never displays prices until you do.
AUDIT_BILLING_MODE="free"

# ─── Razorpay (optional paid features — not published yet) ───────────────────
# Only used when AUDIT_BILLING_MODE=paid. Leave blank to keep checkout closed:
# no payment can be taken without both keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret from Razorpay dashboard → Settings → Webhooks (for webhook verification).
RAZORPAY_WEBHOOK_SECRET=""
# Optional amount overrides in INR for the server-side depth table.
RAZORPAY_DEEP_AUDIT_PRICE_INR=""
RAZORPAY_COMPLETE_AUDIT_PRICE_INR=""

# ─── CMS (self-hosted blog + admin at /cms) ─────────────────────────────────
# The CMS stores everything in PostgreSQL. These variables are optional; the
# public site works without any of them.

# Where uploaded images are written. Point this at a mounted volume in
# production, otherwise uploads disappear on the next deploy.
CMS_STORAGE_DIR="./storage/uploads"

# Maximum upload size in bytes (default 5 MB).
CMS_MAX_UPLOAD_BYTES="5242880"

# Bearer key for the CMS HTTP API (POST /api/cms/posts, /api/cms/media).
# Use 32+ random characters. Leave empty to disable the API entirely.
# Generate with: openssl rand -hex 32
CMS_API_KEY=""

# Shared secret for the revalidation webhook (POST /api/cms/revalidate).
# The request is signed with HMAC-SHA256 over "<timestamp>.<body>".
CMS_REVALIDATE_SECRET=""

# Signs the preview links the editor hands out for unpublished posts, so the
# author can see the real page without publishing it. Leave empty to reuse
# CMS_REVALIDATE_SECRET (or CMS_API_KEY) as the signing key.
CMS_PREVIEW_SECRET=""

# Used by `node scripts/seed-admin.mjs` to create the first administrator.
# CMS_ADMIN_EMAIL=""
# CMS_ADMIN_PASSWORD=""
