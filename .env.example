# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. In Docker/Coolify, `db` is the compose service
# name (or the internal hostname Coolify shows for a Postgres resource).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ─── Optional (safe defaults shown) ──────────────────────────────────────────
# Set to "true" when the provider requires TLS (Neon, Supabase, RDS, …).
DATABASE_SSL="false"
# Only relevant with DATABASE_SSL=true: verify the server certificate.
DATABASE_SSL_STRICT="false"

# Connection pool + per-statement timeout.
DATABASE_POOL_MAX="10"
DATABASE_STATEMENT_TIMEOUT_MS="10000"

# Run `drizzle/*.sql` migrations on container start (Docker entrypoint only).
RUN_MIGRATIONS="true"

# Next.js telemetry.
NEXT_TELEMETRY_DISABLED="1"

# ─── docker-compose only ─────────────────────────────────────────────────────
# Host port for the web service (ignored by Coolify, which routes via Traefik).
APP_PORT="3000"
POSTGRES_USER="ytcpm"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="ytcpm"

# ─── Channel Auditor (public YouTube channel audits) ─────────────────────────
# YouTube Data API key. Required for live audits; the key stays server-side.
YOUTUBE_API_KEY=""

# Signs audit pagination/export tokens. Use 32+ random characters.
# Generate with: openssl rand -hex 32
AUDIT_SIGNING_SECRET=""

# "free" (default) keeps every audit depth free while we launch.
# Set to "paid" to require a Razorpay-purchased plan for Half/Full audits.
AUDIT_BILLING_MODE="free"

# ─── Razorpay (premium Half / Full audits — later) ───────────────────────────
# When AUDIT_BILLING_MODE=paid, these enable checkout. Leave blank to keep
# checkout closed: no payment can be taken without both keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Secret from Razorpay dashboard → Settings → Webhooks (for webhook verification).
RAZORPAY_WEBHOOK_SECRET=""
# Optional price overrides in INR. Defaults: Half Audit 499, Full Audit 1499.
RAZORPAY_HALF_AUDIT_PRICE_INR=""
RAZORPAY_FULL_AUDIT_PRICE_INR=""
